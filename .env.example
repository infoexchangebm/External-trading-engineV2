# Server & Environment Setup
PORT=8080
NODE_ENV=production
LOG_LEVEL=INFO

# Database & Cache Layer
DATABASE_URL=postgres://trading:trading_secret@localhost:5432/trading_engine
REDIS_URL=redis://localhost:6379

# Institutional Risk Engine Parameters (Prop-Firm Safe Defaults)
MAX_DAILY_LOSS_USD=1000
MAX_WEEKLY_LOSS_USD=3000
MAX_POSITION_SIZE_USD=50000
MAX_ASSET_EXPOSURE_USD=100000
MAX_TRADES_PER_HOUR=10
MAX_SPREAD_PIPS=3.0

# External Market Data & API Keys
FRED_API_KEY=your_fred_key_here
ALPHAVANTAGE_API_KEY=your_av_key_here
FINNHUB_API_KEY=your_finnhub_key_here

# Multi-Broker Credentials
OANDA_API_KEY=your_oanda_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id
BINANCE_API_KEY=your_binance_key_here
BINANCE_SECRET=your_binance_secret_here
DERIV_APP_ID=your_deriv_app_id
ICMARKETS_FIX_HOST=fix.icmarkets.com
ICMARKETS_FIX_PORT=9876
ICMARKETS_SENDER_COMP_ID=your_sender_comp_id
MT5_WEB_REQUEST_TOKEN=your_mt5_security_token

# TradingView Webhook Integration
TRADINGVIEW_WEBHOOK_URL=https://hooks.tradingview.com/tradingview-webhook

# Engine Configuration
SYMBOLS=EURUSD,GBPUSD,XAUUSD,AAPL,SPY,CL=F,BTCUSD
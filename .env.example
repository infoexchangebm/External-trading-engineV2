# =============================================================================
# External Trading Engine - example configuration
# Copy to .env (`cp .env.example .env`) and fill in real values. Never commit .env.
# =============================================================================

# --- Shared -----------------------------------------------------------------
# Required. Sent as the X-API-Key header by the dashboard, TradingView alerts
# and the MT5 bridge. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change_me_generate_a_long_random_value
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the APIs. Never use "*".
CORS_ORIGINS=http://localhost:24212,http://localhost:5173

# --- Express API server (artifacts/api-server) -------------------------------
API_PORT=8080
NODE_ENV=production
DATABASE_URL=postgres://trading:trading_secret@localhost:5432/trading_engine
REDIS_URL=redis://localhost:6379
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
JSON_BODY_LIMIT=256kb
TRUST_PROXY=1

# --- Python signal engine (app/) --------------------------------------------
ENGINE_PORT=8000
ENV=production
HOST=0.0.0.0
PORT=8000
LOG_FILE=logs/trading_engine.log
SYMBOLS=BTCUSDT,ETHUSDT
EARNINGS_TICKERS=AAPL,MSFT,GOOGL
SCAN_INTERVAL_MINUTES=15
SIGNAL_THRESHOLD=0.4
ORDERBOOK_IMBALANCE_THRESHOLD=0.15
ATR_STOP_MULTIPLIER=1.5
ATR_TARGET_MULTIPLIER=3.0
WEIGHT_MACRO=0.25
WEIGHT_ORDERBOOK=0.30
WEIGHT_EARNINGS=0.15
WEIGHT_TECHNICAL=0.30
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
# Log signals instead of dispatching them. Start here.
DRY_RUN=true
# Set to true only if you knowingly want to run production without an API key.
ALLOW_INSECURE=false

# --- Postgres container ------------------------------------------------------
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_secret
POSTGRES_DB=trading_engine

# --- Dashboard ---------------------------------------------------------------
UI_PORT=24212

# --- Institutional risk engine (prop-firm safe defaults) ---------------------
MAX_DAILY_LOSS_USD=1000
MAX_WEEKLY_LOSS_USD=3000
MAX_POSITION_SIZE_USD=50000
MAX_ASSET_EXPOSURE_USD=100000
MAX_TRADES_PER_HOUR=10
MAX_SPREAD_PIPS=3.0

# --- Market data providers ---------------------------------------------------
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
BINANCE_BASE_URL=https://api.binance.com

# --- Broker credentials ------------------------------------------------------
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
BINANCE_API_KEY=
BINANCE_SECRET=
DERIV_APP_ID=
ICMARKETS_FIX_HOST=fix.icmarkets.com
ICMARKETS_FIX_PORT=9876
ICMARKETS_SENDER_COMP_ID=
MT5_WEB_REQUEST_TOKEN=

# --- TradingView -------------------------------------------------------------
TRADINGVIEW_WEBHOOK_URL=
